APP_ENV=dev
DATABASE_URL=postgresql+psycopg://purchase_user:purchase_pass@localhost:5432/purchase_price
POSTGRES_DB=purchase_price
POSTGRES_USER=purchase_user
POSTGRES_PASSWORD=purchase_pass
LOG_LEVEL=INFO

# Cloudflare R2 raw evidence / DB backup storage.
# Never commit real credentials. Use a bucket-scoped Object Read & Write S3 API token.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=price-check-raw
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional override. If omitted, derived as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_RAW_PREFIX=raw/v1
R2_BACKUP_PREFIX=db-backups/v1

# Public Data Portal
# Never commit a real service key. Put it only in local .env or deployment secrets.
# General precedence remains source-specific > DATA_GO_KR_MARKET_SERVICE_KEY > legacy common key.
# G2B is split by API family because ShoppingMall and bid/award/pre-spec services can be approved
# under different data.go.kr subscriptions.
DATA_GO_KR_SERVICE_KEY=
DATA_GO_KR_MARKET_SERVICE_KEY=
MFDS_SERVICE_KEY=
G2B_SERVICE_KEY=
G2B_SHOPPING_SERVICE_KEY=
G2B_RESEARCH_SERVICE_KEY=

G2B_SHOPPING_BASE_URL=https://apis.data.go.kr/1230000/at/ShoppingMallPrdctInfoService
G2B_CONTRACT_BASE_URL=
G2B_REQUEST_TIMEOUT_SECONDS=20
G2B_MAX_RETRIES=3

MFDS_MODEL_INFO_BASE_URL=https://apis.data.go.kr/1471000/MdeqModlInfoService01
MFDS_BUSINESS_LICENSE_BASE_URL=https://apis.data.go.kr/1471000/MdlpMnfcturPrmisnInfoService01
MFDS_REQUEST_TIMEOUT_SECONDS=20
MFDS_MAX_RETRIES=3
